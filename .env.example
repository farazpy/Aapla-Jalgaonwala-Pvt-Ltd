# ==============================================================================
# AAPLA JALGAONWALA - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env on your VPS and update the values for your domain/keys.
# Any value left blank will fall back to safe defaults or Admin Panel dynamic config.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=https://aaplajalgaonwala.com
COOKIE_SECRET=ajw_production_secure_cookie_secret_key_2026_change_this

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CONFIGURATION (HIGH PRIORITY FOR VPS)
# ------------------------------------------------------------------------------
# Configure your local or managed MySQL 8+ database on the VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aaplajalgaonwala
DB_PASSWORD=your_secure_db_password
DB_NAME=aaplajalgaonwala
# Alternatively, you can supply a full connection URL instead of individual parameters:
# DB_URL=mysql://aaplajalgaonwala:your_secure_db_password@127.0.0.1:3306/aaplajalgaonwala

# ------------------------------------------------------------------------------
# 3. ADMIN SECURITY & NOTIFICATIONS
# ------------------------------------------------------------------------------
ADMIN_PIN=1234
ADMIN_NOTIFICATION_EMAIL=orders@aaplajalgaonwala.com

# ------------------------------------------------------------------------------
# 4. TELECLOUD S3 REMOTE STORAGE (PRIMARY STORAGE ENGINE)
# ------------------------------------------------------------------------------
# High-speed remote S3 cluster for product images, category banners & icons
TELECLOUD_ENDPOINT_URL=https://s3.htknetwork.in/api/v1/upload
TELECLOUD_API_KEY=
TELECLOUD_WORKSPACE_ID=

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA CDN (LEGACY / FALLBACK STORAGE)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Required for collecting prepaid online payments, UPI, and COD advance fees
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL CONFIGURATION (TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Used for order confirmation emails, invoice PDFs, OTPs, and partner alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aapla Jalgaonwala" <orders@aaplajalgaonwala.com>

# ------------------------------------------------------------------------------
# 8. TELEGRAM INSTANT ORDER & INQUIRY ALERTS
# ------------------------------------------------------------------------------
# Instant notification alerts dispatched to your Telegram bot & admin chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 9. GOOGLE OAUTH 2.0 (SIGN IN WITH GOOGLE)
# ------------------------------------------------------------------------------
# Used for customer one-click login and registration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 10. GOOGLE RECAPTCHA (ANTI-BOT PROTECTION)
# ------------------------------------------------------------------------------
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------------------
# 11. GOOGLE MAPS PLATFORM (PINCODE & ADDRESS AUTOCOMPLETE)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 12. GOOGLE GEMINI AI (SMART ASSISTANT & PRODUCT AUTO-ENHANCEMENT)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
